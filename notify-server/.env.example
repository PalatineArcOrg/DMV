# Dead Man's Vault notify server config. Copy to .env and fill in.
# Loaded via `node --env-file=.env` (see the systemd unit).

# Environment. Anything other than "development" is treated as production, which
# fail-closes: the server REFUSES TO BOOT without REGISTER_SECRET set (so the
# write endpoints can never be silently left open). Set to development ONLY for
# local testing where open endpoints are acceptable.
NODE_ENV=production

# Solana RPC. A Helius URL is strongly recommended to avoid public-RPC 429s
# during execution cranks: https://devnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=https://api.devnet.solana.com

# The cluster this deploy expects. At boot the server verifies the RPC's genesis hash against
# it (fail-closed: it won't start on a mismatch/unreachable RPC). 'devnet' | 'mainnet-beta'.
# A mainnet deploy MUST set mainnet-beta AND EXECUTOR_ENABLED=1.
EXPECTED_CLUSTER=devnet

# DMV Anchor program id
PROGRAM_ID=GXCu5964mvgAJDWmcMriZpzU3vDVqPzjYCM1sxCnsoEb

# HTTP port (Caddy reverse-proxies notify.palatinearc.com to this)
PORT=8787

# How often to poll the chain for each registered vault (ms).
# Keep this low enough that it can't skip a whole stage: demo-mode stages are ~30s
# each, so 15000 (15s) is used in practice. A coarse interval (e.g. 60000) could
# step over a short stage and miss its notification.
POLL_INTERVAL_MS=15000

# SQLite file location
DB_PATH=/root/DMV/notify-server/data/registrations.db

# Shared secret required on ALL write endpoints (register/deregister/poll-now/
# execute-now). REQUIRED in production — the server refuses to start without it.
# Set a long random string; the app sends the same value as the x-dmv-secret
# header. NOTE: this secret ships inside the app bundle and is extractable, so it
# provides weak authenticity only; registration is additionally ownership-proofed
# against on-chain vault state. Rotate periodically.
REGISTER_SECRET=

# --- FCM push notifications ---
# Firebase project id (from the Firebase console / service-account JSON "project_id")
FCM_PROJECT_ID=
# Absolute path to the Firebase service-account JSON (keep OUTSIDE git, like other creds)
FCM_SERVICE_ACCOUNT=/root/.dmv_fcm_service_account.json

# --- Permissionless executor (autonomous distribution after grace) ---
# Set to 1 to enable the keyless crank. When enabled with a funded CRANKER_KEYPAIR,
# the server distributes a vault's assets on-chain once its grace period elapses —
# no app, no owner action required. The cranker controls nothing: payouts are
# computed on-chain and can only reach the pre-set beneficiaries.
EXECUTOR_ENABLED=0
# Absolute path to the cranker keypair JSON (solana-keygen format). It only PAYS
# tx fees + new-PDA rent; it is NOT a vault authority. Keep OUTSIDE git (gitignored).
# Fund it with a little devnet SOL. Generate: solana-keygen new -o cranker.json
CRANKER_KEYPAIR=/root/DMV/notify-server/cranker.json
# A mainnet deploy (EXPECTED_CLUSTER=mainnet-beta) REFUSES to boot with the executor off,
# so a crankerless mainnet can't ship by accident. If cranking is deliberately delegated to
# a separate keeper-bot (the two-cranker model), set ALLOW_NO_EXECUTOR=1 to run notify-only.
ALLOW_NO_EXECUTOR=0
