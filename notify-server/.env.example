# Dead Man's Vault notify server config. Copy to .env and fill in.
# Loaded via `node --env-file=.env` (see the systemd unit).

# Environment. Anything other than "development" is treated as production, which
# fail-closes: the server REFUSES TO BOOT without REGISTER_SECRET set (so the
# write endpoints can never be silently left open). Set to development ONLY for
# local testing where open endpoints are acceptable.
NODE_ENV=production

# Solana RPC. A Helius URL is strongly recommended to avoid public-RPC 429s
# during execution cranks: https://devnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=https://api.devnet.solana.com

# The cluster this deploy expects. The server CLASSIFIES the RPC's genesis hash against it:
# a positive MISMATCH (wrong cluster) is FATAL (won't start); a transient UNREACHABLE/timeout RPC
# starts the API in DEGRADED and retries with backoff (poller/executor stay OFF until VERIFIED).
# 'devnet' | 'mainnet-beta'. A mainnet deploy MUST set mainnet-beta AND EXECUTOR_ENABLED=1
# (or ALLOW_NO_EXECUTOR=1 for a notify-only deploy).
EXPECTED_CLUSTER=devnet

# DMV Anchor program id
PROGRAM_ID=GXCu5964mvgAJDWmcMriZpzU3vDVqPzjYCM1sxCnsoEb

# HTTP port (Caddy reverse-proxies notify.palatinearc.com to this)
PORT=8787

# How often to poll the chain for each registered vault (ms).
# Keep this low enough that it can't skip a whole stage: demo-mode stages are ~30s
# each, so 15000 (15s) is used in practice. A coarse interval (e.g. 60000) could
# step over a short stage and miss its notification.
POLL_INTERVAL_MS=15000

# SQLite file location
DB_PATH=/root/DMV/notify-server/data/registrations.db

# --- Registration authentication (WP3) ---
# Mode: legacy | dual | signed.
#   legacy  — unsigned x-dmv-secret path only. DEVELOPMENT ONLY (fatal in prod).
#   dual    — accept BOTH owner-signed (V2) and legacy unsigned; a failed signed
#             attempt NEVER downgrades to legacy, and a signed row can't be touched
#             via the legacy path. Requires REGISTER_SECRET. (Devnet transition.)
#   signed  — owner-signed only; REGISTER_SECRET not required. REQUIRED on mainnet.
# A missing mode is fatal outside NODE_ENV=development; an unknown value is fatal.
REGISTRATION_AUTH_MODE=dual

# WP4: legacy-acceptance cutoff — an absolute Unix timestamp (whole seconds). In
# `dual` mode this is REQUIRED and must be at most 30 days in the future; pure
# legacy register/deregister are accepted only until this instant, after which the
# server serves them 410 (signed requests keep working). Once the running process
# observes expiry, legacy stays closed for the life of the process (one-way latch).
# MUST be ABSENT/empty in `signed` and (dev) `legacy` mode. Leave empty here.
REGISTRATION_LEGACY_ACCEPT_UNTIL=

# LEGACY registration secret — used ONLY by the unsigned legacy/dual x-dmv-secret
# path (NOT by signed routes and NOT by admin routes). Required for legacy/dual;
# ignored in signed mode. Ships in the app bundle (extractable → weak authenticity);
# registration is additionally ownership-proofed on-chain. Set a long random string.
REGISTER_SECRET=

# SERVER-ONLY admin secret for the operational routes (/poll-now, /execute-now,
# /debug/push), sent as the x-dmv-admin-secret header. MUST differ from
# REGISTER_SECRET, is NEVER shipped to the app, and is required outside
# NODE_ENV=development. Set a long random string; keep it server-side only.
ADMIN_SECRET=

# --- FCM push notifications ---
# Firebase project id (from the Firebase console / service-account JSON "project_id")
FCM_PROJECT_ID=
# Absolute path to the Firebase service-account JSON (keep OUTSIDE git, like other creds)
FCM_SERVICE_ACCOUNT=/root/.dmv_fcm_service_account.json

# --- Permissionless executor (autonomous distribution after grace) ---
# Set to 1 to enable the keyless crank. When enabled with a funded CRANKER_KEYPAIR,
# the server distributes a vault's assets on-chain once its grace period elapses —
# no app, no owner action required. The cranker controls nothing: payouts are
# computed on-chain and can only reach the pre-set beneficiaries.
EXECUTOR_ENABLED=0
# Absolute path to the cranker keypair JSON (solana-keygen format). It only PAYS
# tx fees + new-PDA rent; it is NOT a vault authority. Keep OUTSIDE git (gitignored).
# Fund it with a little devnet SOL. Generate: solana-keygen new -o cranker.json
CRANKER_KEYPAIR=/root/DMV/notify-server/cranker.json
# A mainnet deploy (EXPECTED_CLUSTER=mainnet-beta) REFUSES to boot with the executor off,
# so a crankerless mainnet can't ship by accident. If cranking is deliberately delegated to
# a separate keeper-bot (the two-cranker model), set ALLOW_NO_EXECUTOR=1 to run notify-only.
ALLOW_NO_EXECUTOR=0
# Optional: pin the cranker keypair's pubkey. If set, the loaded keypair MUST match (guards a
# wrong/rotated keypair file). Base58 pubkey; leave empty to skip.
EXPECTED_CRANKER_PUBKEY=

# --- Operational readiness (Phase 2) ---
# Cranker balance thresholds (SOL). Below MIN the executor is marked NOT ready and does NOT submit
# transactions — escalation + API stay UP (an executor problem never silences notifications). Below
# WARN it logs a warning. Defaults: mainnet 0.10/0.20, devnet 0.02/0.05.
MIN_CRANKER_BALANCE_SOL=
WARN_CRANKER_BALANCE_SOL=
# On mainnet FCM is a mandatory escalation dependency: the server REFUSES TO BOOT if the service
# account is missing/unreadable/malformed/incomplete (static check before listen). Set 1 ONLY for a
# deliberate notify-disabled deploy. (Provider/token outages AFTER a valid static config stay runtime-
# degraded, not fatal.)
ALLOW_NO_FCM=0
# Require the on-chain program account to be executable during readiness checks (default on). Set 0 to
# skip — but mainnet-beta REFUSES to boot with this off (must never report ready over a non-executable
# program).
REQUIRE_PROGRAM_EXECUTABLE=1
# Poll-cycle health thresholds. A poll cycle counts as a healthy read only if
#   readErrors <= POLL_MAX_FAILURE_ABS  AND  readErrors/checked <= POLL_MAX_FAILURE_RATIO  AND  >=1 read succeeded.
# Conservative defaults (0.05 / 2) suit a small fleet; RAISE POLL_MAX_FAILURE_ABS for a large fleet so a
# handful of transient read blips don't demote pollerReady (→ /health DEGRADED).
POLL_MAX_FAILURE_RATIO=0.05
POLL_MAX_FAILURE_ABS=2
