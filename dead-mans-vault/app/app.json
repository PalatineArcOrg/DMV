{
  "expo": {
    "name": "Dead Man's Vault",
    "slug": "dead-mans-vault",
    "version": "1.13.11",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080A0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080A0F"
      },
      "package": "com.romulusol.deadmansvault",
      "googleServicesFile": "./google-services.json",
      "versionCode": 97,
      "allowBackup": false,
      "permissions": [
        "POST_NOTIFICATIONS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00FFA3"
        }
      ],
      "expo-font",
      "expo-local-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "b1221e75-1816-4ff6-80bf-8f15f31b27d9"
      }
    }
  }
}
