{
  "name": "app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "config:identity": "npx expo config --type public",
    "build:eas:legacy-bridge": "npx eas build --profile legacy-bridge --platform android",
    "build:eas:successor-devnet": "npx eas build --profile successor-devnet --platform android",
    "preflight:release": "node ../release-tools/verify-manifest.mjs && node ../release-tools/preflight-prod-build.mjs --surface app",
    "verify:android-artifact": "node scripts/verify-android-artifact.mjs",
    "test": "node --test 'src/**/*.test.ts' 'scripts/**/*.test.mjs'"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.16",
    "@react-navigation/native": "^6.1.14",
    "@react-navigation/native-stack": "^6.9.22",
    "@solana-mobile/mobile-wallet-adapter-protocol": "2.2.2",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "2.2.2",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.78.4",
    "@tanstack/react-query": "5.101.4",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "date-fns": "4.4.0",
    "expo": "^52.0.43",
    "expo-constants": "~17.0.8",
    "expo-clipboard": "~7.0.1",
    "expo-crypto": "~14.0.2",
    "expo-dev-client": "~5.0.19",
    "expo-font": "~13.0.4",
    "expo-local-authentication": "~15.0.2",
    "expo-modules-core": "~2.2.3",
    "expo-notifications": "~0.29.14",
    "expo-secure-store": "~14.0.1",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "js-base64": "^3.9.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "^15.15.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@types/react": "~18.3.12",
    "typescript": "^5.1.3"
  },
  "private": true
}
