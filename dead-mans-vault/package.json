{
  "license": "ISC",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "build:prod": "anchor build",
    "build:devnet": "anchor build -- --features devnet",
    "verify:manifest": "node release-tools/verify-manifest.mjs",
    "preflight:prod": "node release-tools/preflight-prod-build.mjs",
    "test:devnet": "anchor build -- --features devnet && anchor test --skip-build",
    "test:fuzz": "NODE_OPTIONS='--max-old-space-size=2048 --expose-gc' bash -c 'for f in tests/fuzz/*.fuzz.ts; do echo \"→ $f\"; ts-mocha -p ./tests/fuzz/tsconfig.json -t 300000 \"$f\" || exit 1; done'"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.15"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "fast-check": "^4.9.0",
    "litesvm": "^1.2.1",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
