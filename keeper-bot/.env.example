RPC_URL=https://api.devnet.solana.com
KEYPAIR_PATH=./keeper.json
POLL_MS=30000
# Cluster this keeper expects. Its genesis hash is CLASSIFIED against the RPC every tick: a positive
# MISMATCH (wrong cluster) is FATAL (exit non-zero); a transient UNREACHABLE RPC is DEGRADED — the
# keeper stays alive, does NOT crank, and retries with bounded backoff (no crash/restart loop).
# 'devnet' | 'mainnet-beta'. A mainnet keeper MUST set mainnet-beta.
EXPECTED_CLUSTER=devnet

# Rent-claim close of executed vaults. Set 1 on MAINNET (economic incentive; the owner-exclusive close
# window is 24h). Keep 0 for a CRANK-ONLY keeper (fires the switch, never sweeps an owner's rent) —
# REQUIRED on devnet, where the close window is only 60s. This example targets devnet, so it ships 0.
CLOSE_EXECUTED=0

# --- Operational readiness (Phase 2) ---
# Keeper balance thresholds (SOL). Below MIN the keeper stays alive but does NOT crank (degraded,
# bounded backoff); below WARN it logs a warning. Leave these COMMENTED OUT to use the safe code
# defaults (mainnet 0.05/0.10, devnet 0.02/0.05). An empty or whitespace-only value is also treated
# as "use the default" — it does NOT disable the balance floor. Uncomment to override.
# MIN_KEEPER_BALANCE_SOL=0.02
# WARN_KEEPER_BALANCE_SOL=0.05
