# All build-time (Vite) vars.

# Default RPC = the notify-server proxy (Helius key injected server-side by Caddy,
# never shipped in the bundle). ?cluster=devnet keeps network labels/explorer links
# correct (the proxy URL itself carries no cluster hint). Users can override this at
# runtime in Settings → Network (stored in localStorage).
VITE_RPC_URL=https://notify.palatinearc.com/rpc?cluster=devnet

# Notify-server base (heir auto-discovery via GET /inheritances).
VITE_NOTIFY_URL=https://notify.palatinearc.com

# The Solana cluster this build expects. The fail-closed network gate (BootGate) verifies
# the RPC's genesis hash against it and blocks on mismatch. 'devnet' | 'mainnet-beta'.
# A mainnet build MUST set this to mainnet-beta.
VITE_EXPECTED_CLUSTER=devnet
